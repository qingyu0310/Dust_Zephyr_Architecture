{
    "terminal.integrated.env.windows": {
        "ZEPHYR_BASE": "E:\\Zephyr_Test\\zephyr",
        "SDK_GLUE_DIR": "E:\\Zephyr_HPMicro_Test\\sdk_glue",
        "ZEPHYR_SDK_GLUE_MODULE_DIR": "E:\\Zephyr_HPMicro_Test\\sdk_glue",
        "ZEPHYR_SDK_INSTALL_DIR": "E:\\Zephyr_Test\\zephyr-sdk-0.16.8",
        "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
        "VIRTUAL_ENV": "E:\\Zephyr_Test\\.venv",
        "PATH": "E:\\Zephyr_Test\\.venv\\Scripts;${env:PATH}"
    },

    "python.defaultInterpreterPath": "E:\\Zephyr_Test\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,

    "terminal.integrated.profiles.windows": {
        "Zephyr Shell": {
            "path": "powershell.exe",
            "args": [
                "-NoExit",
                "-Command",
                "& 'E:\\Zephyr_Test\\.venv\\Scripts\\Activate.ps1'; $env:ZEPHYR_BASE='E:\\Zephyr_Test\\zephyr'; $env:ZEPHYR_SDK_INSTALL_DIR='E:\\Zephyr_Test\\zephyr-sdk-0.16.8'; $env:ZEPHYR_TOOLCHAIN_VARIANT='zephyr'; Write-Host '[Zephyr venv activated]' -ForegroundColor Green"
            ]
        }
    },

    "terminal.integrated.defaultProfile.windows": "Zephyr Shell",

    "clangd.path": "C:\\Users\\33527\\AppData\\Roaming\\Code\\User\\globalStorage\\llvm-vs-code-extensions.vscode-clangd\\install\\21.1.0\\clangd_21.1.0\\bin\\clangd.exe",

    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--completion-style=detailed",
        "--query-driver=E:/Zephyr_Test/zephyr-sdk-0.16.8/arm-zephyr-eabi/bin/arm-zephyr-eabi-g++.exe,E:/Zephyr_Test/zephyr-sdk-0.16.8/riscv64-zephyr-elf/bin/riscv64-zephyr-elf-g++.exe",
        "--compile-commands-dir=.",
        "--log=verbose"
    ],

    "cortex-debug.openocdPath.windows": "E:/Zephyr_HPMicro_Test/sdk_env/tools/openocd/openocd.exe",

    "files.associations": {
        "*.overlay": "devicetree",
        "*.conf": "properties",
        "Kconfig*": "kconfig"
    },

    "workbench.tree.indent": 10,
    "workbench.tree.renderIndentGuides": "always",
    "explorer.compactFolders": false,
    "explorer.enableUndo": false,

    "workbench.colorCustomizations": {
        "tree.indentGuidesStroke": "#00ff73"
    },

    // 缩进设置
    "editor.tabSize": 4,
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,

    // Zephyr DeviceTree / Overlay
    "[devicetree]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.detectIndentation": false
    }
}